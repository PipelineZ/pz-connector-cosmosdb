<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- MinVer drives the package version from git tags (MinVerTagPrefix "v" -> tags like v0.1.0).
       Pre-tag builds produce a height-based 0.0.0-alpha prerelease; the first release tag is v0.1.0. -->
  <ItemGroup>
    <PackageReference Include="MinVer" Version="6.*" PrivateAssets="All" />
  </ItemGroup>

  <PropertyGroup>
    <MinVerTagPrefix>v</MinVerTagPrefix>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsPackable)' != 'false'">
    <Authors>PipelineZ contributors</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/PipelineZ/pz-connector-cosmosdb</RepositoryUrl>
    <PackageProjectUrl>https://pipelinez.dev</PackageProjectUrl>
    <!-- "pipelinez-connector" is the ratified discovery tag for pz connector packages. -->
    <PackageTags>pipelinez-connector;pipelinez;pz;cosmosdb;cosmos;azure;nosql;etl;elt;data-pipeline;arrow</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" />
    <None Include="$(MSBuildThisFileDirectory)assets/brand/pz-icon.png" Pack="true" PackagePath="icon.png" Visible="false" />
  </ItemGroup>
</Project>
