<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Description>Azure Cosmos DB (NoSQL API) source and sink connector for PipelineZ (pz), served out of process.</Description>
    <!-- Microsoft.Azure.Cosmos deserialises its query plan through Newtonsoft into internal generic
         types Native AOT never instantiates (reads fail at runtime even with every assembly rooted),
         so this connector ships as a self-contained CoreCLR binary. -->
    <PzPackaging>self-contained</PzPackaging>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Pz.Connectors.Sdk" Version="0.6.1" />
    <PackageReference Include="Pz.Connectors.Abstractions" Version="0.6.1" />
    <PackageReference Include="Microsoft.Azure.Cosmos" Version="3.63.0" />
    <!-- The SDK's build targets refuse to compile without a direct Newtonsoft reference >= 10.0.2. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Pz.Connector.CosmosDb.Tests" />
  </ItemGroup>

</Project>
